# Copy to .env and set your key
# OPENAI_API_KEY=
"model": "venice-uncensored"
# Optional model controls
LEAD_AGENT_USE_MODEL=false
LEAD_AGENT_MODEL=gpt-5.4-mini
LEAD_AGENT_MODEL_TIMEOUT_SECONDS=30

# Optional custom .env path override via CLI: --dotenv-path path/to/.env
LEAD_AGENT_DOTENV_PATH=.env
