# Copy to .env and set your key
# OPENAI_API_KEY=

# Model provider: openai, venice, openrouter
LEAD_AGENT_MODEL_PROVIDER=openrouter

# Model to use (must be valid for your provider)
# OpenRouter examples: google/gemini-2.0-flash-001, deepseek/deepseek-chat, meta-llama/llama-3.3-70b-instruct
LEAD_AGENT_MODEL=google/gemini-2.0-flash-001
LEAD_AGENT_MODEL_API_KEY=

LEAD_AGENT_USE_MODEL=true
LEAD_AGENT_MODEL_TIMEOUT_SECONDS=30

# Optional custom .env path override via CLI: --dotenv-path path/to/.env
LEAD_AGENT_DOTENV_PATH=.env
